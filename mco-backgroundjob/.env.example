# Redis / Asynq
REDIS_ADDR=localhost:6379

# Supabase/PostgreSQL access used by the trusted background worker.
# Keep the service-role key server-side only; never expose it to the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me

# Marketplace endpoint. For local development this can point to a mock server.
SHOPEE_BASE_URL=http://localhost:9090
