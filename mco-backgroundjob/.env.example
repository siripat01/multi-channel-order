# Redis / Asynq
REDIS_ADDR=localhost:6379

# Supabase/PostgreSQL access used by the background worker.
# Use a server-side key only in trusted server environments.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=replace-me

# Marketplace endpoint. For local development this can point to a mock server.
SHOPEE_BASE_URL=http://localhost:9090
